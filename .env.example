# Big Bounty — environment variables (example)
# Copy to .env.local for local dev, or set these in the Vercel/Function App
# environment. NEVER commit real secrets. All values below are placeholders.

# ===========================================================================
# Email Exposure Check (defensive breach-exposure feature)
# ===========================================================================

# IntelBase breach-lookup API key. Server-side ONLY — never exposed to the
# browser or committed. Requests must come from an IP you have whitelisted in
# your IntelBase account (check with GET https://api.intelbase.is/account/ip).
# Vercel serverless egress IPs are dynamic; if IntelBase requires a fixed IP,
# route the lookup through a host with a static outbound IP (e.g. the worker VM).
INTELBASE_API_KEY=YOUR_API_KEY_HERE

# Optional override of the IntelBase base URL (defaults to https://api.intelbase.is)
# INTELBASE_BASE_URL=https://api.intelbase.is

# Ownership-verification email delivery (Resend HTTP API). Without these the
# one-time code cannot be sent, so no exposure results are ever shown — the
# feature degrades safely rather than skipping verification.
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=Big Bounty <verify@your-verified-domain.com>

# NOTE: ownership verification reuses the existing BIGBOUNTY_HMAC_SECRET below
# to sign the one-time-code token. No separate secret is needed.

# ===========================================================================
# Core signing / async scan pipeline (existing)
# ===========================================================================

# Shared HMAC secret for stateless tokens (job dispatch, share links, and the
# exposure one-time-code token). Use a long random value.
BIGBOUNTY_HMAC_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Azure Function App base URL + function key for job dispatch
BIGBOUNTY_FUNCTIONS_BASE=https://your-func-app.azurewebsites.net
BIGBOUNTY_FUNCTION_KEY=YOUR_FUNCTION_KEY

# Azure Storage (queue + blob results + job/auth tables)
BIGBOUNTY_STORAGE_CONNECTION=YOUR_STORAGE_CONNECTION_STRING
BIGBOUNTY_JOBS_QUEUE=bigbounty-jobs
BIGBOUNTY_JOBS_TABLE=bigbountyJobs
BIGBOUNTY_AUTH_TABLE=bigbountyAuth
BIGBOUNTY_RESULTS_CONTAINER=bigbounty-results

# Worker / reliability tuning (optional — sensible defaults in code)
# BIGBOUNTY_JOB_TIMEOUT_MS=900000
# BIGBOUNTY_MAX_ATTEMPTS=3
# BIGBOUNTY_MAX_CONCURRENCY=1
# BIGBOUNTY_POLL_IDLE_MS=5000
# BIGBOUNTY_AUTH_TTL_DAYS=30

# Azure identifiers used by management/ops tooling (optional)
# BIGBOUNTY_SUBSCRIPTION_ID=YOUR_SUBSCRIPTION_ID
# BIGBOUNTY_VM_NAME=your-worker-vm
# BIGBOUNTY_VM_RG=your-resource-group

# ===========================================================================
# Optional scan integrations (existing)
# ===========================================================================
# BROWSERBASE_API_KEY=
# OPENROUTER_BUGBOUNTY=
# NVIDIA_BUGBOUNTY=
